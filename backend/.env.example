# 1) APPLICATION — runtime identity and logging
APP_NAME="Telegram AI Assistant"
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
RUN_MODE=polling

# 2) TELEGRAM — create the token with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_PARSE_MODE=none
TELEGRAM_MAX_MESSAGE_LENGTH=4000

# 3) AI PROVIDER — obtain the key from the selected provider
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1200
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# 4) IMAGE GENERATION PROVIDER — provider key/model are optional for Pollinations only when its current service permits
IMAGE_PROVIDER=pollinations
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_BASE_URL=
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT_SECONDS=120
IMAGE_MAX_RETRIES=2
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 5) AGENT BEHAVIOUR / SAFETY LIMITS
AGENT_MEMORY_TURNS=8
AGENT_MEMORY_TTL_SECONDS=3600
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60
MAX_INPUT_CHARS=4000
STARTUP_STRICT=false
HTTP_MAX_RETRIES=2
HTTP_TIMEOUT_SECONDS=30

# 6) IMAGE TEXT OVERLAY
IMAGE_OVERLAY_ENABLED=true
IMAGE_OVERLAY_POSITION=auto
IMAGE_OVERLAY_MAX_LINES=4
IMAGE_OVERLAY_FONT_PATH=

# 7) SOCIAL PUBLISHING — provider dashboards supply these values
SOCIAL_ENABLED=true
PENDING_POST_TTL_SECONDS=1800
SOCIAL_MAX_PENDING_PER_CHAT=5
SOCIAL_PENDING_DIR=
SOCIAL_PUBLIC_BASE_URL=
META_GRAPH_VERSION=v21.0
INSTAGRAM_LOGIN_FLOW=facebook
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# 8) SOCIAL ACCOUNT CONNECTIONS — OAuth apps come from each vendor's developer portal
OAUTH_STATE_TTL_SECONDS=600
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
SOCIAL_DB_PATH=
SOCIAL_TOKEN_KEY=

